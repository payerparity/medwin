---
import Layout from '@/layouts/BoldLayout.astro';
import Locations from '@/components/bold/Locations.astro';
import { practice, telHref } from '@/content/practice';
import { services, commonConditions } from '@/content/services';
import { brochures } from '@/content/brochures';
import { doctor } from '@/content/doctor';
import { home } from '@/content/site';
const base = '/bold/';
const stats = [
  { n: String(brochures.length), l: 'Procedures we perform' },
  { n: '4', l: 'Board certifications' },
  { n: '2', l: 'Texas locations' },
  { n: '1:1', l: 'Therapist to patient' },
];
---
<Layout title={practice.name}>
  <section class="hero">
    <div class="hero-stripes" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">{home.eyebrow}</span>
      <h1>Get back to work.<br /><span class="hl">Get back to play.</span></h1>
      <p class="lead">{home.subhead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={base + 'contact/'}>{home.primaryCta}</a>
        <a class="btn btn-outline" href={telHref(practice.primaryPhone)}>Call {practice.primaryPhone}</a>
      </div>
      <ul class="stats">{stats.map((s) => <li class="stat"><strong>{s.n}</strong><span>{s.l}</span></li>)}</ul>
    </div>
  </section>

  <section class="section light" style="padding-top: var(--s-8)">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" style="color:#5f7a00">What we do</span>
        <h2>Diagnose it. Treat it. <span style="color:#5f7a00">Train through it.</span></h2>
      </div>
      <div class="strip">
        {services.map((s, i) => (
          <article class="tile">
            <span class="num" aria-hidden="true">0{i + 1}</span>
            <h3>{s.shortTitle}</h3>
            <p style="color:#9aa3ad">{s.blurb}</p>
            <ul>{s.highlights.slice(0, 4).map((h) => <li>{h}</li>)}</ul>
            <a class="btn btn-primary" href={base + s.slug + '/'}>Details</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee" aria-label="Conditions we treat">
    <ul aria-hidden="true">{[...commonConditions, ...commonConditions].map((c) => <li>{c}</li>)}</ul>
    <ul class="visually-hidden">{commonConditions.map((c) => <li>{c}</li>)}</ul>
  </div>

  <section class="section">
    <div class="container doc">
      <div class="doc-photo"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
      <div>
        <span class="eyebrow">Meet the doctor</span>
        <h2>{doctor.name}</h2>
        <p class="lead" style="margin-top: var(--s-3)">{doctor.title}</p>
        <ul class="creds">{doctor.credentials.map((c) => <li>{c.short}</li>)}</ul>
        <blockquote>“<span>{doctor.quote}</span>”</blockquote>
        <a class="btn btn-outline" href={base + 'doctor/'}>Full profile</a>
      </div>
    </div>
  </section>

  <section class="section light cut-top">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" style="color:#5f7a00">Locations</span>
        <h2>Two offices. One call.</h2>
      </div>
      <Locations />
    </div>
  </section>

  <section class="cta">
    <span class="ghost" aria-hidden="true">GO</span>
    <div class="container">
      <h2>{home.closing}</h2>
      <p>Request an appointment and we'll call you back — usually the same business day.</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={base + 'contact/'}>{home.primaryCta}</a>
        <a class="btn btn-outline" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
      </div>
    </div>
  </section>
</Layout>
