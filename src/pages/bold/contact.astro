---
import Layout from '@/layouts/BoldLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from '@/components/bold/Locations.astro';
import { practice, telHref } from '@/content/practice';
---
<Layout title="Contact" description="Request an appointment or call our Brownsville or Sugar Land office.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let's get <span class="hl">started.</span></h1>
      <p class="lead">Fill out the form and we'll call you back, or reach the office directly at <a href={telHref(practice.primaryPhone)} class="hl">{practice.primaryPhone}</a>.</p>
    </div>
  </section>
  <section class="section container contact-grid">
    <div class="aside-card"><ContactForm buttonLabel="Send request" /></div>
    <div class="aside">
      <div class="aside-card"><h3>Office hours</h3><ul class="hours">{practice.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>Email</h3><a href={`mailto:${practice.primaryEmail}`} class="hl">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="section light cut-top">
    <div class="container">
      <div class="section-head"><span class="eyebrow" style="color:#5f7a00">Locations</span><h2>Find us</h2></div>
      <Locations maps />
    </div>
  </section>
</Layout>
