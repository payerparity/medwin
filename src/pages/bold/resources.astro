---
import Layout from '@/layouts/BoldLayout.astro';
import BrochureList from '@/components/shared/BrochureList.astro';
import { practice } from '@/content/practice';
---
<Layout title="Patient Resources" description="Patient portal access and procedure brochures in English and Spanish.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Patients</span>
      <h1>Know your <span class="hl">procedure.</span></h1>
      <p class="lead">Your records, and a straight-talking guide to every procedure we perform — in English or Spanish.</p>
    </div>
  </section>
  <section class="section container">
    <div class="resource-cards">
      <article class="aside-card">
        <h3>Patient portal</h3>
        <p style="margin-bottom: var(--s-4)">View visit summaries, request refills and message the office through our secure eClinicalWorks portal.</p>
        <a class="btn btn-primary" href={practice.portalUrl} target="_blank" rel="noopener">Open portal ↗</a>
      </article>
      <article class="aside-card">
        <h3>Procedure brochures</h3>
        <p style="margin-bottom: var(--s-4)">What each injection treats, how it's done, and what to expect afterward. Many are available in Spanish.</p>
        <a class="btn btn-outline" href="#brochures">Browse ↓</a>
      </article>
    </div>
    <div class="section-head" id="brochures"><span class="eyebrow">Brochures</span><h2>Procedure guides</h2><p>PDF · opens in a new tab. <span lang="es">Folletos disponibles en español.</span></p></div>
    <BrochureList />
  </section>
</Layout>
