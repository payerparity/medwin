---
import Layout from '@/layouts/WarmLayout.astro';
import BrochureList from '@/components/shared/BrochureList.astro';
import { practice } from '@/content/practice';
---
<Layout title="Patient Resources" description="Patient portal access and procedure brochures in English and Spanish.">
  <section class="page-head container">
    <span class="eyebrow">For patients</span>
    <h1>Everything you need <em>before your visit</em></h1>
    <p class="lead">Your records, and a plain-language guide to every procedure we perform — in English or Spanish.</p>
  </section>
  <section class="container" style="padding-bottom: var(--s-9)">
    <div class="resource-cards">
      <article class="resource-card">
        <span class="glyph" aria-hidden="true">✦</span>
        <h3>Patient portal</h3>
        <p>View visit summaries, request refills and message the office through our secure eClinicalWorks portal.</p>
        <a class="btn btn-primary" href={practice.portalUrl} target="_blank" rel="noopener">Open the patient portal ↗</a>
      </article>
      <article class="resource-card">
        <span class="glyph" aria-hidden="true">❦</span>
        <h3>Procedure brochures</h3>
        <p>What each injection treats, how it's done, and what to expect afterward. Many are available in Spanish.</p>
        <a class="btn btn-secondary" href="#brochures">Browse brochures ↓</a>
      </article>
    </div>
    <div class="section-head" id="brochures"><span class="eyebrow">Brochures</span><h2>Procedure guides</h2><p>PDF · opens in a new tab. <span lang="es">Folletos disponibles en español.</span></p></div>
    <BrochureList />
  </section>
</Layout>
