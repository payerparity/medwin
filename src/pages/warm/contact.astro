---
import Layout from '@/layouts/WarmLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from '@/components/warm/Locations.astro';
import { practice, telHref } from '@/content/practice';
---
<Layout title="Contact" description="Request an appointment or call our Brownsville or Sugar Land office.">
  <section class="page-head container">
    <span class="eyebrow">Contact</span>
    <h1>We'd love to <em>hear from you</em></h1>
    <p class="lead">Fill out the form and we'll call you back, or reach the office directly at <a href={telHref(practice.primaryPhone)} style="color:var(--terra)">{practice.primaryPhone}</a>.</p>
  </section>
  <section class="container contact-grid" style="padding-bottom: var(--s-8)">
    <div class="aside-card"><ContactForm buttonLabel="Send request" /></div>
    <div class="aside">
      <div class="aside-card"><h3>Office hours</h3><ul class="hours">{practice.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>Email</h3><a href={`mailto:${practice.primaryEmail}`} style="color:var(--terra);font-weight:600">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="container" style="padding-bottom: var(--s-9)">
    <div class="section-head"><span class="eyebrow">Locations</span><h2>Find us</h2></div>
    <Locations maps />
  </section>
</Layout>
