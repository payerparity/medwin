---
import Layout from '@/layouts/WarmLayout.astro';
import { doctor } from '@/content/doctor';
import { practice, telHref } from '@/content/practice';
const base = '/warm/';
---
<Layout title={doctor.name} description={doctor.summary}>
  <section class="section container doctor">
    <div class="doctor-photo"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
    <div>
      <span class="eyebrow">Meet the doctor</span>
      <h1 style="margin-bottom: var(--s-3)">{doctor.name}</h1>
      <p class="lead">{doctor.title}</p>
      <ul class="creds">{doctor.credentials.map((c) => <li>{c.short}</li>)}</ul>
    </div>
  </section>
  <section class="container two-col" style="padding-bottom: var(--s-9)">
    <div class="prose">
      <blockquote class="doctor" style="display:block"><span style="font-family:var(--serif);font-size:1.6rem;font-style:italic">“{doctor.quote}”</span></blockquote>
      <div>{doctor.bio.map((p) => <p>{p}</p>)}</div>
    </div>
    <aside class="aside">
      <div class="aside-card"><h3>Board certifications</h3><ul>{doctor.credentials.map((c) => <li>{c.long}</li>)}</ul></div>
      <div class="aside-card"><h3>Training & affiliations</h3><ul>{doctor.affiliations.map((a) => <li>{a}</li>)}</ul></div>
      <div class="aside-card call">
        <h3>Schedule a consultation</h3>
        <a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
        <a class="btn btn-primary" href={base + 'contact/'}>Request an appointment</a>
      </div>
    </aside>
  </section>
</Layout>
