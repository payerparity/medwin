---
import Layout from '@/layouts/EditorialLayout.astro';
import BrochureList from '@/components/shared/BrochureList.astro';
import { practice } from '@/content/practice';
---
<Layout title="Patient Resources" description="Patient portal access and procedure brochures in English and Spanish.">
  <section class="page-head container">
    <span class="eyebrow">For patients</span>
    <h1>Resources</h1>
    <p class="lead">Your records, and a plain-language guide to every procedure we perform — in English or Spanish.</p>
  </section>
  <section class="section container" style="padding-top: var(--s-6)">
    <div class="resource-cards">
      <article class="resource-card">
        <h3>Patient portal</h3>
        <p>View visit summaries, request refills and message the office through our secure eClinicalWorks portal.</p>
        <a class="btn btn-solid" href={practice.portalUrl} target="_blank" rel="noopener">Open the portal ↗</a>
      </article>
      <article class="resource-card">
        <h3>Procedure brochures</h3>
        <p>What each injection treats, how it is done, and what to expect afterward. Many are available in Spanish.</p>
        <a class="btn" href="#brochures">Browse brochures ↓</a>
      </article>
    </div>
    <div class="section-head" id="brochures"><h2>Procedure guides</h2><p>PDF · opens in a new tab. <span lang="es">Folletos disponibles en español.</span></p></div>
    <BrochureList />
  </section>
</Layout>
