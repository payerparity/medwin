---
import Layout from '@/layouts/EditorialLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from '@/components/editorial/Locations.astro';
import { practice, telHref } from '@/content/practice';
---
<Layout title="Contact" description="Request an appointment or call our Brownsville or Sugar Land office.">
  <section class="page-head container">
    <span class="eyebrow">Contact</span>
    <h1>Request an <em>appointment</em></h1>
    <p class="lead">Fill out the form and we will call you back, or reach the office directly at <a href={telHref(practice.primaryPhone)} class="link">{practice.primaryPhone}</a>.</p>
  </section>
  <section class="section container contact-grid" style="padding-top: var(--s-6)">
    <div><ContactForm buttonLabel="Send request" /></div>
    <div class="aside">
      <div class="aside-card"><h3>Office hours</h3><ul class="hours">{practice.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>Email</h3><a href={`mailto:${practice.primaryEmail}`} class="link">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="section container" style="padding-top:0">
    <div class="section-head"><h2>Locations</h2><p>Two offices, one phone number.</p></div>
    <Locations maps />
  </section>
</Layout>
