---
import Layout from '@/layouts/ClinicalLayout.astro';
import Icon from '@/components/clinical/Icons.astro';
import { doctor } from '@/content/doctor';
import { practice, telHref } from '@/content/practice';
const base = '/clinical/';
---
<Layout title={doctor.name} description={doctor.summary}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Meet the doctor</span>
      <h1>{doctor.name}</h1>
      <p class="lead">{doctor.title}</p>
    </div>
  </section>
  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <div class="doctor-photo" style="max-width: 28rem"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
        <blockquote>“{doctor.quote}”</blockquote>
        <div>{doctor.bio.map((p) => <p>{p}</p>)}</div>
      </div>
      <aside class="aside">
        <div class="aside-card">
          <h3>Board certifications</h3>
          <ul>{doctor.credentials.map((c) => <li>{c.long}</li>)}</ul>
        </div>
        <div class="aside-card">
          <h3>Training & affiliations</h3>
          <ul>{doctor.affiliations.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div class="aside-card call">
          <h3>Schedule a consultation</h3>
          <a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
          <a class="btn" href={base + 'contact/'}>Request an appointment</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
