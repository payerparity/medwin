---
import Layout from '@/layouts/ClinicalLayout.astro';
import Icon from '@/components/clinical/Icons.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import MapEmbed from '@/components/shared/MapEmbed.astro';
import { practice, locations, telHref, formatAddress, mapsHref } from '@/content/practice';
---
<Layout title="Contact" description="Request an appointment or call our Brownsville or Sugar Land office.">
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Request an appointment</h1>
      <p class="lead">Fill out the form and we'll call you back, or reach the office directly at <a href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>.</p>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div class="aside-card"><ContactForm buttonLabel="Send request" /></div>
      <div class="aside" style="position: static">
        <div class="aside-card">
          <h3>Office hours</h3>
          <ul class="hours">{practice.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul>
        </div>
        <div class="aside-card">
          <h3>Email</h3>
          <a href={`mailto:${practice.primaryEmail}`}>{practice.primaryEmail}</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <div class="section-head"><span class="eyebrow">Locations</span><h2>Find us</h2></div>
      <div class="locations">
        {locations.map((l) => (
          <article class="location">
            <MapEmbed location={l} />
            <div class="location-body">
              <h3>{l.name}</h3>
              <address>{formatAddress(l)}<br /><a href={telHref(l.phone)}>{l.phone}</a> · Fax {l.fax}</address>
              <div class="location-actions">
                <a class="btn btn-primary" href={telHref(l.phone)}><Icon name="phone" size={16} /> Call</a>
                <a class="btn btn-secondary" href={mapsHref(l)} target="_blank" rel="noopener">Directions</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
