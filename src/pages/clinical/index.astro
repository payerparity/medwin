---
import Layout from '@/layouts/ClinicalLayout.astro';
import Icon from '@/components/clinical/Icons.astro';
import MapEmbed from '@/components/shared/MapEmbed.astro';
import { practice, locations, telHref, formatAddress, mapsHref } from '@/content/practice';
import { services, commonConditions } from '@/content/services';
import { doctor } from '@/content/doctor';
import { home } from '@/content/site';
const base = '/clinical/';
const icons = { 'pain-management': 'spine', 'physical-therapy': 'therapy', 'workers-comp': 'work' } as const;
---
<Layout title={practice.name}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{home.eyebrow}</span>
        <h1>{home.headline}</h1>
        <p class="lead">{home.subhead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={base + 'contact/'}>{home.primaryCta}</a>
          <a class="btn btn-secondary" href={telHref(practice.primaryPhone)}><Icon name="phone" size={18} /> {home.secondaryCta} {practice.primaryPhone}</a>
        </div>
        <ul class="hero-trust">
          {home.trustPoints.map((t) => <li><strong>{t.label}</strong><span>{t.detail}</span></li>)}
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="grid" viewBox="0 0 400 400" preserveAspectRatio="none"><defs><pattern id="g" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0v40" fill="none" stroke="#fff" stroke-width="1"/></pattern></defs><rect width="400" height="400" fill="url(#g)"/></svg>
        <div class="float-card fc-1"><span class="ic"><Icon name="shield" /></span><div><strong>Board-certified</strong><span>AAPMR · ABIPP · ABPM</span></div></div>
        <div class="float-card fc-2"><span class="ic"><Icon name="clock" /></span><div><strong>Same-day procedures</strong><span>Home the same afternoon</span></div></div>
        <div class="float-card fc-3"><span class="ic"><Icon name="pin" /></span><div><strong>2 Texas locations</strong><span>Brownsville · Sugar Land</span></div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Three services, one plan of care</h2>
        <p>Diagnosis, treatment and recovery under one roof — so your pain specialist and your physical therapist are on the same page.</p>
      </div>
      <div class="cards">
        {services.map((s) => (
          <article class="card">
            <span class="ic"><Icon name={icons[s.slug]} /></span>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
            <ul>{s.highlights.slice(0, 4).map((h) => <li>{h}</li>)}</ul>
            <a class="btn btn-ghost" href={base + s.slug + '/'}>Learn more →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Conditions</span>
        <h2>Commonly treated</h2>
      </div>
      <ul class="chips">{commonConditions.map((c) => <li class="chip">{c}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="container doctor-grid">
      <div class="doctor-photo"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
      <div>
        <span class="eyebrow">Meet the doctor</span>
        <h2>{doctor.name}</h2>
        <p class="lead" style="margin-top: var(--s-2)">{doctor.title}</p>
        <div class="badges">{doctor.credentials.map((c) => <span class="badge"><Icon name="check" size={14} />{c.short}</span>)}</div>
        <p>{doctor.summary}</p>
        <blockquote>“{doctor.quote}”</blockquote>
        <a class="btn btn-secondary" href={base + 'doctor/'}>Full profile</a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Locations</span>
        <h2>Two offices, one phone call</h2>
      </div>
      <div class="locations">
        {locations.map((l) => (
          <article class="location">
            <MapEmbed location={l} />
            <div class="location-body">
              <h3>{l.name}</h3>
              <address>{formatAddress(l)}<br /><a href={telHref(l.phone)}>{l.phone}</a> · Fax {l.fax}</address>
              <div class="location-actions">
                <a class="btn btn-primary" href={telHref(l.phone)}><Icon name="phone" size={16} /> Call</a>
                <a class="btn btn-secondary" href={mapsHref(l)} target="_blank" rel="noopener">Directions</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>{home.closing}</h2>
          <p>Request an appointment and we'll call you back — usually the same business day.</p>
        </div>
        <a class="btn btn-primary" href={base + 'contact/'}>{home.primaryCta}</a>
      </div>
    </div>
  </section>
</Layout>
