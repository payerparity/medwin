---
import { nav } from '@/content/site';
import { practice, telHref } from '@/content/practice';
import Icon from './Icons.astro';
const base = '/clinical/';
const path = Astro.url.pathname;
const isCurrent = (p: string) => path === base + p;
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={base}>
      <span class="brand-mark"><Icon name="spine" size={20} /></span>
      <span>{practice.name}<small>Pain · Therapy · Rehabilitation</small></span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {nav.filter(n => n.path !== '').map((n) => (
        <a href={base + n.path} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary nav-cta" href={telHref(practice.primaryPhone)}><Icon name="phone" size={18} /> {practice.primaryPhone}</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
      <span class="visually-hidden">Menu</span><Icon name="menu" />
    </button>
  </div>
  <nav class="nav-mobile" id="mobile-nav" hidden aria-label="Primary mobile">
    {nav.map((n) => (
      <a href={base + n.path} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>
    ))}
    <a class="btn btn-primary" href={telHref(practice.primaryPhone)}><Icon name="phone" size={18} /> Call {practice.primaryPhone}</a>
  </nav>
</header>
<script>
  const t = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const m = document.getElementById('mobile-nav');
  t?.addEventListener('click', () => {
    const open = t.getAttribute('aria-expanded') === 'true';
    t.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
  });
</script>
