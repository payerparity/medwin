---
import Layout from '@/layouts/ClinicalLayout.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, localePath, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { doctor, ui } = getContent(lang);
const href = (p: string) => localePath('clinical', lang, p);
---
<Layout title={doctor.name} description={doctor.summary} lang={lang}>
  <section class="page-head">
    <div class="container"><span class="eyebrow">{ui.meetDoctor}</span><h1>{doctor.name}</h1><p class="lead">{doctor.title}</p></div>
  </section>
  <section class="section">
    <div class="container two-col">
      <div class="prose">
        <div class="doctor-photo" style="max-width: 28rem"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
        <blockquote>“{doctor.quote}”</blockquote>
        <div>{doctor.bio.map((p) => <p>{p}</p>)}</div>
      </div>
      <aside class="aside">
        <div class="aside-card"><h3>{ui.boardCerts}</h3><ul>{doctor.credentials.map((c) => <li>{c.long}</li>)}</ul></div>
        <div class="aside-card"><h3>{ui.training}</h3><ul>{doctor.affiliations.map((a) => <li>{a}</li>)}</ul></div>
        <div class="aside-card call">
          <h3>{ui.scheduleConsultation}</h3>
          <a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
          <a class="btn" href={href('contact/')}>{ui.requestAppointment}</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
