---
import MapEmbed from '@/components/shared/MapEmbed.astro';
import Icon from './Icons.astro';
import { locations, telHref, formatAddress, mapsHref } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
---
<div class="locations">
  {locations.map((l) => (
    <article class="location">
      <MapEmbed location={l} lang={lang} />
      <div class="location-body">
        <h3>{l.name}</h3>
        <address>{formatAddress(l)}<br /><a href={telHref(l.phone)}>{l.phone}</a> · {ui.fax} {l.fax}</address>
        <div class="location-actions">
          <a class="btn btn-primary" href={telHref(l.phone)}><Icon name="phone" size={16} /> {ui.call}</a>
          <a class="btn btn-secondary" href={mapsHref(l)} target="_blank" rel="noopener">{ui.directions}</a>
        </div>
      </div>
    </article>
  ))}
</div>
