---
import Layout from '@/layouts/ClinicalLayout.astro';
import Icon from './Icons.astro';
import { practice, telHref } from '@/content/practice';
import { serviceBySlug, type Service } from '@/content/services';
interface Props { slug: Service['slug']; }
const s = serviceBySlug(Astro.props.slug);
const base = '/clinical/';
---
<Layout title={s.title} description={s.blurb}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>{s.title}</h1>
      <p class="lead">{s.intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container two-col">
      <div class="prose">
        {s.sections.map((sec) => (
          <div>
            <h2>{sec.heading}</h2>
            {sec.paragraphs.map((p) => <p>{p}</p>)}
            {sec.bullets && <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>}
          </div>
        ))}
      </div>
      <aside class="aside">
        <div class="aside-card">
          <h3>At a glance</h3>
          <ul>{s.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
        <div class="aside-card call">
          <h3>Talk to us</h3>
          <a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
          <a class="btn" href={base + 'contact/'}>Request an appointment</a>
        </div>
      </aside>
    </div>
  </section>
  {s.conditionGroups && (
    <section class="section section-soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">Conditions</span><h2>What we treat</h2></div>
        <div class="conditions">
          {s.conditionGroups.map((g) => (
            <div class="condition"><h3>{g.title}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
