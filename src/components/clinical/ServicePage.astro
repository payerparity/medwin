---
import Layout from '@/layouts/ClinicalLayout.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, serviceBySlug, localePath, type Lang } from '@/i18n';
import type { Service } from '@/data/services';
interface Props { slug: Service['slug']; lang: Lang; }
const { slug, lang } = Astro.props;
const s = serviceBySlug(lang, slug);
const { ui } = getContent(lang);
const href = (p: string) => localePath('clinical', lang, p);
---
<Layout title={s.title} description={s.blurb} lang={lang}>
  <section class="page-head">
    <div class="container"><span class="eyebrow">{ui.services}</span><h1>{s.title}</h1><p class="lead">{s.intro}</p></div>
  </section>
  <section class="section">
    <div class="container two-col">
      <div class="prose">
        {s.sections.map((sec) => (
          <div><h2>{sec.heading}</h2>{sec.paragraphs.map((p) => <p>{p}</p>)}{sec.bullets && <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>}</div>
        ))}
      </div>
      <aside class="aside">
        <div class="aside-card"><h3>{ui.atAGlance}</h3><ul>{s.highlights.map((h) => <li>{h}</li>)}</ul></div>
        <div class="aside-card call">
          <h3>{ui.talkToUs}</h3>
          <a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
          <a class="btn" href={href('contact/')}>{ui.requestAppointment}</a>
        </div>
      </aside>
    </div>
  </section>
  {s.conditionGroups && (
    <section class="section section-soft">
      <div class="container">
        <div class="section-head"><span class="eyebrow">{ui.conditions}</span><h2>{ui.whatWeTreat}</h2></div>
        <div class="conditions">{s.conditionGroups.map((g) => <div class="condition"><h3>{g.title}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>)}</div>
      </div>
    </section>
  )}
</Layout>
