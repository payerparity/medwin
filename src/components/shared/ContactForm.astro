---
// Structural markup only; each vibe styles .form / .field in its own CSS.
import { practice, locations } from '@/data/practice';
import { ui } from '@/data/ui';
import type { Lang } from '@/i18n';
interface Props { lang: Lang; buttonLabel?: string; }
const { lang, buttonLabel } = Astro.props;
const t = ui[lang].form;
---
<form class="form" action={practice.contactFormEndpoint} method="POST" data-contact-form
  data-sending={t.sending} data-success={t.success} data-error={t.error}>
  <input type="hidden" name="language" value={lang} />
  <div class="form-row">
    <label class="field"><span>{t.firstName}</span><input type="text" name="first_name" autocomplete="given-name" required /></label>
    <label class="field"><span>{t.lastName}</span><input type="text" name="last_name" autocomplete="family-name" required /></label>
  </div>
  <div class="form-row">
    <label class="field"><span>{t.email}</span><input type="email" name="email" autocomplete="email" required /></label>
    <label class="field"><span>{t.phone}</span><input type="tel" name="phone" autocomplete="tel" /></label>
  </div>
  <label class="field">
    <span>{t.preferredLocation}</span>
    <select name="location">
      <option value="">{t.noPreference}</option>
      {locations.map((l) => <option value={l.id}>{l.name}</option>)}
    </select>
  </label>
  <label class="field"><span>{t.message}</span><textarea name="message" rows="5" required></textarea></label>
  <p class="form-note">{t.note}</p>
  <button type="submit" class="btn btn-primary">{buttonLabel ?? ui[lang].sendRequest}</button>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = form.dataset.sending ?? '';
    try {
      const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
      if (res.ok) { status.textContent = form.dataset.success ?? ''; form.reset(); }
      else status.textContent = form.dataset.error ?? '';
    } catch { status.textContent = form.dataset.error ?? ''; }
  });
</script>
