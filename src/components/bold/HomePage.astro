---
import Layout from '@/layouts/BoldLayout.astro';
import Locations from './Locations.astro';
import { practice, telHref } from '@/data/practice';
import { brochures } from '@/data/brochures';
import { getContent, localePath, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { services, commonConditions, doctor, home, ui } = getContent(lang);
const t = ui.bold;
const href = (p: string) => localePath('bold', lang, p);
const stats = [String(brochures.length), '4', '2', '1:1'].map((n, i) => ({ n, l: t.stats[i] }));
---
<Layout title={practice.name} lang={lang}>
  <section class="hero">
    <div class="hero-stripes" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow">{home.eyebrow}</span>
      <h1>{t.headline1}<br /><span class="hl">{t.headline2}</span></h1>
      <p class="lead">{home.subhead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={href('contact/')}>{home.primaryCta}</a>
        <a class="btn btn-outline" href={telHref(practice.primaryPhone)}>{ui.call} {practice.primaryPhone}</a>
      </div>
      <ul class="stats">{stats.map((s) => <li class="stat"><strong>{s.n}</strong><span>{s.l}</span></li>)}</ul>
    </div>
  </section>

  <section class="section light" style="padding-top: var(--s-8)">
    <div class="container">
      <div class="section-head"><span class="eyebrow" style="color:#5f7a00">{ui.whatWeDo}</span><h2>{t.servicesTitleBefore}<span style="color:#5f7a00">{t.servicesTitleEm}</span></h2></div>
      <div class="strip">
        {services.map((s, i) => (
          <article class="tile">
            <span class="num" aria-hidden="true">0{i + 1}</span>
            <h3>{s.shortTitle}</h3>
            <p style="color:#9aa3ad">{s.blurb}</p>
            <ul>{s.highlights.slice(0, 4).map((h) => <li>{h}</li>)}</ul>
            <a class="btn btn-primary" href={href(s.slug + '/')}>{ui.details}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee" aria-label={ui.whatWeTreat}>
    <ul aria-hidden="true">{[...commonConditions, ...commonConditions].map((c) => <li>{c}</li>)}</ul>
    <ul class="visually-hidden">{commonConditions.map((c) => <li>{c}</li>)}</ul>
  </div>

  <section class="section">
    <div class="container doc">
      <div class="doc-photo"><img src={doctor.photo} alt={doctor.photoAlt} width="477" height="331" /></div>
      <div>
        <span class="eyebrow">{ui.meetDoctor}</span>
        <h2>{doctor.name}</h2>
        <p class="lead" style="margin-top: var(--s-3)">{doctor.title}</p>
        <ul class="creds">{doctor.credentials.map((c) => <li>{c.short}</li>)}</ul>
        <blockquote>“<span>{doctor.quote}</span>”</blockquote>
        <a class="btn btn-outline" href={href('doctor/')}>{ui.fullProfile}</a>
      </div>
    </div>
  </section>

  <section class="section light cut-top">
    <div class="container">
      <div class="section-head"><span class="eyebrow" style="color:#5f7a00">{ui.locations}</span><h2>{t.locationsTitle}</h2></div>
      <Locations lang={lang} />
    </div>
  </section>

  <section class="cta">
    <span class="ghost" aria-hidden="true">{t.ghost}</span>
    <div class="container">
      <h2>{home.closing}</h2>
      <p>{ui.ctaSub}</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href={href('contact/')}>{home.primaryCta}</a>
        <a class="btn btn-outline" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
      </div>
    </div>
  </section>
</Layout>
