---
import { nav } from '@/content/site';
import { practice, telHref } from '@/content/practice';
const base = '/bold/';
const path = Astro.url.pathname;
const isCurrent = (p: string) => path === base + p;
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={base}><i aria-hidden="true"></i>Ace Pain Management</a>
    <nav class="nav-links" aria-label="Primary">
      {nav.filter(n => n.path !== '').map((n) => <a href={base + n.path} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="btn btn-primary nav-cta" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>Menu</button>
  </div>
  <nav class="nav-mobile" id="mobile-nav" hidden aria-label="Primary mobile">
    {nav.map((n) => <a href={base + n.path} aria-current={isCurrent(n.path) ? 'page' : undefined}>{n.label}</a>)}
    <a class="btn btn-primary" href={telHref(practice.primaryPhone)}>Call {practice.primaryPhone}</a>
  </nav>
</header>
<script>
  const t = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const m = document.getElementById('mobile-nav');
  t?.addEventListener('click', () => {
    const open = t.getAttribute('aria-expanded') === 'true';
    t.setAttribute('aria-expanded', String(!open));
    t.textContent = open ? 'Menu' : 'Close';
    if (m) m.hidden = open;
  });
</script>
