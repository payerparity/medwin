---
import Layout from '@/layouts/BoldLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from './Locations.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
const t = ui.bold;
---
<Layout title={ui.contact} lang={lang}>
  <section class="page-head"><div class="container"><span class="eyebrow">{ui.contact}</span><h1>{t.contactTitleBefore}<span class="hl">{t.contactTitleEm}</span></h1><p class="lead">{ui.pages.contactLeadBefore}<a href={telHref(practice.primaryPhone)} class="hl">{practice.primaryPhone}</a>{ui.pages.contactLeadAfter}</p></div></section>
  <section class="section container contact-grid">
    <div class="aside-card"><ContactForm lang={lang} /></div>
    <div class="aside">
      <div class="aside-card"><h3>{ui.officeHours}</h3><ul class="hours">{ui.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>{ui.email}</h3><a href={`mailto:${practice.primaryEmail}`} class="hl">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="section light cut-top">
    <div class="container"><div class="section-head"><span class="eyebrow" style="color:#5f7a00">{ui.locations}</span><h2>{ui.findUs}</h2></div><Locations lang={lang} maps /></div>
  </section>
</Layout>
