---
import Layout from '@/layouts/WarmLayout.astro';
import BrochureList from '@/components/shared/BrochureList.astro';
import { practice } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
const t = ui.warm;
---
<Layout title={ui.pages.resourcesTitle} description={t.resourcesLead} lang={lang}>
  <section class="page-head container">
    <span class="eyebrow">{ui.forPatients}</span>
    <h1>{t.resourcesTitleBefore}<em>{t.resourcesTitleEm}</em></h1>
    <p class="lead">{t.resourcesLead}</p>
  </section>
  <section class="container" style="padding-bottom: var(--s-9)">
    <div class="resource-cards">
      <article class="resource-card"><span class="glyph" aria-hidden="true">✦</span><h3>{ui.patientPortal}</h3><p>{ui.portalBlurb}</p><a class="btn btn-primary" href={practice.portalUrl} target="_blank" rel="noopener">{ui.openPortal}</a></article>
      <article class="resource-card"><span class="glyph" aria-hidden="true">❦</span><h3>{ui.procedureBrochures}</h3><p>{ui.brochuresBlurb}</p><a class="btn btn-secondary" href="#brochures">{ui.browseBrochures}</a></article>
    </div>
    <div class="section-head" id="brochures"><span class="eyebrow">{ui.brochures}</span><h2>{ui.procedureGuides}</h2><p>{ui.guidesNote} <span lang={lang === 'es' ? 'en' : 'es'}>{ui.guidesNoteOther}</span></p></div>
    <BrochureList lang={lang} />
  </section>
</Layout>
