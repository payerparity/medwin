---
import Layout from '@/layouts/WarmLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from './Locations.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
const t = ui.warm;
---
<Layout title={ui.contact} lang={lang}>
  <section class="page-head container">
    <span class="eyebrow">{ui.contact}</span>
    <h1>{t.contactTitleBefore}<em>{t.contactTitleEm}</em></h1>
    <p class="lead">{ui.pages.contactLeadBefore}<a href={telHref(practice.primaryPhone)} style="color:var(--terra)">{practice.primaryPhone}</a>{ui.pages.contactLeadAfter}</p>
  </section>
  <section class="container contact-grid" style="padding-bottom: var(--s-8)">
    <div class="aside-card"><ContactForm lang={lang} /></div>
    <div class="aside">
      <div class="aside-card"><h3>{ui.officeHours}</h3><ul class="hours">{ui.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>{ui.email}</h3><a href={`mailto:${practice.primaryEmail}`} style="color:var(--terra);font-weight:600">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="container" style="padding-bottom: var(--s-9)">
    <div class="section-head"><span class="eyebrow">{ui.locations}</span><h2>{ui.findUs}</h2></div>
    <Locations lang={lang} maps />
  </section>
</Layout>
