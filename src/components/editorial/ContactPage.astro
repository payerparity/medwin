---
import Layout from '@/layouts/EditorialLayout.astro';
import ContactForm from '@/components/shared/ContactForm.astro';
import Locations from './Locations.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
const t = ui.editorial;
---
<Layout title={ui.contact} lang={lang}>
  <section class="page-head container">
    <span class="eyebrow">{ui.contact}</span>
    <h1>{t.contactTitleBefore}<em>{t.contactTitleEm}</em></h1>
    <p class="lead">{ui.pages.contactLeadBefore}<a href={telHref(practice.primaryPhone)} class="link">{practice.primaryPhone}</a>{ui.pages.contactLeadAfter}</p>
  </section>
  <section class="section container contact-grid" style="padding-top: var(--s-6)">
    <div><ContactForm lang={lang} /></div>
    <div class="aside">
      <div class="aside-card"><h3>{ui.officeHours}</h3><ul class="hours">{ui.hours.map((h) => <li><span>{h.days}</span><strong>{h.time}</strong></li>)}</ul></div>
      <div class="aside-card"><h3>{ui.email}</h3><a href={`mailto:${practice.primaryEmail}`} class="link">{practice.primaryEmail}</a></div>
    </div>
  </section>
  <section class="section container" style="padding-top:0">
    <div class="section-head"><h2>{ui.locations}</h2><p>{t.locationsSubShort}</p></div>
    <Locations lang={lang} maps />
  </section>
</Layout>
