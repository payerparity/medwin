---
import Layout from '@/layouts/EditorialLayout.astro';
import { practice, telHref } from '@/data/practice';
import { getContent, serviceBySlug, localePath, type Lang } from '@/i18n';
import type { Service } from '@/data/services';
interface Props { slug: Service['slug']; lang: Lang; }
const { slug, lang } = Astro.props;
const { services, ui } = getContent(lang);
const s = serviceBySlug(lang, slug);
const idx = services.findIndex((x) => x.slug === s.slug) + 1;
const href = (p: string) => localePath('editorial', lang, p);
---
<Layout title={s.title} description={s.blurb} lang={lang}>
  <section class="page-head container"><span class="eyebrow">{ui.services} — 0{idx}</span><h1>{s.title}</h1><p class="lead">{s.intro}</p></section>
  <section class="section container two-col" style="padding-top: var(--s-6)">
    <div class="prose">{s.sections.map((sec) => <div><h2>{sec.heading}</h2>{sec.paragraphs.map((p) => <p>{p}</p>)}{sec.bullets && <ul>{sec.bullets.map((b) => <li>{b}</li>)}</ul>}</div>)}</div>
    <aside class="aside">
      <div class="aside-card"><h3>{ui.atAGlance}</h3><ul>{s.highlights.map((h) => <li>{h}</li>)}</ul></div>
      <div class="aside-card call"><h3>{ui.consultation}</h3><a class="phone" href={telHref(practice.primaryPhone)}>{practice.primaryPhone}</a><a class="btn btn-solid" href={href('contact/')}>{ui.requestAppointment}</a></div>
    </aside>
  </section>
  {s.conditionGroups && (
    <section class="section container" style="padding-top:0">
      <div class="section-head"><h2>{ui.whatWeTreat}</h2><p>{ui.editorial.conditionsPageSub}</p></div>
      <div class="conditions">{s.conditionGroups.map((g) => <div class="condition"><h3>{g.title}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>)}</div>
    </section>
  )}
</Layout>
