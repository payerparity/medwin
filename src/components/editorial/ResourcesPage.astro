---
import Layout from '@/layouts/EditorialLayout.astro';
import BrochureList from '@/components/shared/BrochureList.astro';
import { practice } from '@/data/practice';
import { getContent, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { ui } = getContent(lang);
---
<Layout title={ui.pages.resourcesTitle} description={ui.pages.resourcesLead} lang={lang}>
  <section class="page-head container"><span class="eyebrow">{ui.forPatients}</span><h1>{ui.editorial.resourcesTitle}</h1><p class="lead">{ui.pages.resourcesLead}</p></section>
  <section class="section container" style="padding-top: var(--s-6)">
    <div class="resource-cards">
      <article class="resource-card"><h3>{ui.patientPortal}</h3><p>{ui.portalBlurb}</p><a class="btn btn-solid" href={practice.portalUrl} target="_blank" rel="noopener">{ui.openPortalShort}</a></article>
      <article class="resource-card"><h3>{ui.procedureBrochures}</h3><p>{ui.brochuresBlurb}</p><a class="btn" href="#brochures">{ui.browseBrochures}</a></article>
    </div>
    <div class="section-head" id="brochures"><h2>{ui.procedureGuides}</h2><p>{ui.guidesNote} <span lang={lang === 'es' ? 'en' : 'es'}>{ui.guidesNoteOther}</span></p></div>
    <BrochureList lang={lang} />
  </section>
</Layout>
