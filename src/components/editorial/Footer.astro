---
import { practice, locations, telHref, formatAddress } from '@/data/practice';
import { getContent, localePath, type Lang } from '@/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { nav, ui } = getContent(lang);
const href = (p: string) => localePath('editorial', lang, p);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <a class="brand" href={href('')}>Ace Pain Management<small>{ui.editorial.tagline}</small></a>
    <nav class="footer-links" aria-label="Footer">{nav.map((n) => <a href={href(n.path)}>{n.label}</a>)}</nav>
    <div class="footer-locs">{locations.map((l) => <div><strong>{l.name}</strong>{formatAddress(l)}<br /><a href={telHref(l.phone)}>{l.phone}</a> · {ui.fax} {l.fax}</div>)}</div>
    <div class="footer-bottom">
      <span>© {year} {practice.name}</span>
      <a href={practice.portalUrl} target="_blank" rel="noopener">{ui.portalLink}</a>
      <a href={`mailto:${practice.primaryEmail}`}>{practice.primaryEmail}</a>
    </div>
  </div>
</footer>
